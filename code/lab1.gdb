# ============================================================
# Lab1 练习2 调试脚本
# 用法（终端 B，需先在终端 A 执行 make debug）：
#     riscv64-unknown-elf-gdb -q ./bin/kernel -x lab1.gdb
# ============================================================

set architecture riscv:rv64
set pagination off
file ./bin/kernel
target remote :1234

printf "\n============================================================\n"
printf " [1] 连接成功。当前 PC（应为 0x1000，即复位地址）:\n"
printf "============================================================\n"
info registers pc

printf "\n============================================================\n"
printf " [2] 复位入口处的指令（应为 5 条有效指令 + unimp）:\n"
printf "============================================================\n"
x/8i 0x1000

printf "\n============================================================\n"
printf " [3] 在内核入口 0x80200000 处下断点并运行\n"
printf "============================================================\n"
break *0x80200000
continue
printf "\n>>> 已命中内核入口，当前 PC:\n"
info registers pc
printf "\n>>> 内核入口处的指令（la sp / tail kern_init 展开结果）:\n"
x/3i $pc

printf "\n============================================================\n"
printf " [4] 在 kern_init 下断点，进入 C 语言入口\n"
printf "============================================================\n"
break kern_init
continue
printf "\n>>> 已进入 C 语言，当前寄存器:\n"
info registers ra sp gp tp

printf "\n============================================================\n"
printf " [5] 验证 .bss 清零的实际长度\n"
printf "============================================================\n"
printf ">>> edata 与 end 的差值（本实验产物中为 0，即 memset 实际长度为 0）:\n"
print end - edata

printf "\n============================================================\n"
printf " [6] kern_init 的反汇编（注意结尾的死循环 j 指令）:\n"
printf "============================================================\n"
disassemble /m kern_init

printf "\n============================================================\n"
printf " 调试记录到此结束。若要观察内核输出，请回到运行 QEMU 的终端，\n"
printf " 在下面执行 continue（或 kill 结束本次调试）。\n"
printf "============================================================\n"
